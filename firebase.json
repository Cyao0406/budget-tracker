{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".git/**",
      ".claude/**",
      ".gitignore",
      ".firebaserc",
      "**/.*",
      "*.md",
      "*.log",
      "package.json",
      "package-lock.json",
      "test/**",
      "**/node_modules/**"
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
